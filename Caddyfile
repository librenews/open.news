# Production: Caddy handles TLS termination + reverse proxy.
# In development, use a Cloudflare tunnel pointing to localhost:3001 instead.
# (No Caddy needed locally — Cloudflare handles HTTPS.)

open.news {
    reverse_proxy localhost:3001
}

track.social {
    reverse_proxy localhost:4200
}

feeds.social {
    reverse_proxy localhost:4300
}

longform.social {
    reverse_proxy localhost:4500
}

weblog.social {
    reverse_proxy localhost:4400
}

nearby.at {
    reverse_proxy localhost:4700
}

snip.social {
    reverse_proxy localhost:5100
}
