{
  "name": "open-news",
  "version": "0.1.0",
  "description": "Agentic news reader powered by your Bluesky social graph",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx/esm src/web/index.tsx",
    "dev:web": "node --env-file=.env --import tsx/esm src/web/index.tsx",
    "dev:firehose": "node --env-file=.env --import tsx/esm src/firehose/index.ts",
    "dev:worker": "node --env-file=.env --import tsx/esm src/worker/index.ts",
    "dev:feeds": "node --env-file=.env --import tsx/esm src/feeds/web.ts",
    "migrate": "node --env-file=.env --import tsx/esm src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@atproto/api": "^0.13.23",
    "@atproto/oauth-client-node": "^0.3.4",
    "@aws-sdk/client-s3": "^3.1019.0",
    "@dsnp/parquetjs": "^1.8.7",
    "@hono/node-server": "^1.13.7",
    "@mozilla/readability": "^0.5.0",
    "@opensearch-project/opensearch": "^3.5.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.71.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.213.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.213.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.213.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "cheerio": "^1.0.0",
    "hono": "^4.7.4",
    "ioredis": "^5.10.1",
    "jsdom": "^26.0.0",
    "normalize-url": "^8.0.1",
    "openai": "^4.89.0",
    "pg": "^8.14.1",
    "pg-boss": "^10.1.5",
    "pino": "^9.6.0",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.14",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.5.14",
    "@vitest/coverage-v8": "^4.1.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.0"
  }
}
