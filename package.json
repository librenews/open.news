{
  "name": "open-news",
  "version": "0.1.0",
  "description": "Agentic news reader powered by your Bluesky social graph",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env --import tsx/esm src/web/index.tsx",
    "dev:web": "node --watch --env-file=.env --import tsx/esm src/web/index.tsx",
    "dev:firehose": "node --watch --env-file=.env --import tsx/esm src/firehose/index.ts",
    "dev:worker": "node --watch --env-file=.env --import tsx/esm src/worker/index.ts",
    "dev:feeds": "node --watch --env-file=.env --import tsx/esm src/feeds/web.ts",
    "dev:weblog": "node --watch --env-file=.env --import tsx/esm src/weblog/index.ts",
    "dev:longform": "node --watch --env-file=.env --import tsx/esm src/longform/index.tsx",
    "dev:centipedia": "node --watch --env-file=.env --import tsx/esm src/centipedia/index.tsx",
    "dev:nearby": "node --watch --env-file=.env --import tsx/esm src/nearby/index.tsx",
    "dev:fatlink": "node --watch --env-file=.env --import tsx/esm src/fatlink/index.ts",
    "migrate": "node --env-file=.env --import tsx/esm src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@atproto/api": "^0.13.23",
    "@atproto/oauth-client-node": "^0.3.4",
    "@aws-sdk/client-s3": "^3.1019.0",
    "@dsnp/parquetjs": "^1.8.7",
    "@hocuspocus/extension-database": "^2.15.3",
    "@hocuspocus/server": "^2.15.3",
    "@hono/node-server": "^1.13.7",
    "@mozilla/readability": "^0.5.0",
    "@opensearch-project/opensearch": "^3.5.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.71.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.213.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.213.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.213.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "@types/sanitize-html": "^2.16.1",
    "@wordpress/block-serialization-default-parser": "^5.44.0",
    "archiver": "^7.0.1",
    "basic-auth": "^2.0.1",
    "body-parser": "^2.2.2",
    "cheerio": "^1.0.0",
    "express": "^5.2.1",
    "franc": "^6.2.0",
    "hono": "^4.7.4",
    "ioredis": "^5.10.1",
    "jsdom": "^26.0.0",
    "marked": "^12.0.2",
    "normalize-url": "^8.0.1",
    "openai": "^4.89.0",
    "pg": "^8.14.1",
    "pg-boss": "^10.1.5",
    "pino": "^9.6.0",
    "sanitize-html": "^2.17.4",
    "ws": "^8.18.1",
    "xmlrpc": "^1.3.2",
    "yjs": "^13.6.30",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/basic-auth": "^1.1.8",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^21.1.7",
    "@types/marked": "^6.0.0",
    "@types/node": "^22.13.14",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^7.2.0",
    "@types/wordpress__block-serialization-default-parser": "^3.2.4",
    "@types/ws": "^8.5.14",
    "@types/xmlrpc": "^1.3.10",
    "@vitest/coverage-v8": "^4.1.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.0"
  }
}
