{
  "lexicon": 1,
  "id": "org.centipedia.endorsement.source",
  "defs": {
    "main": {
      "type": "record",
      "description": "An endorsement of a domain/source as trustworthy.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["domain", "createdAt"],
        "properties": {
          "domain": {
            "type": "string",
            "maxLength": 256,
            "description": "The endorsed domain, e.g. 'nature.com', 'arxiv.org'."
          },
          "topic": {
            "type": "string",
            "maxLength": 100,
            "description": "Optional topic scope for this endorsement."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
