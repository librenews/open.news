# ──────────────────────────────────────────────────────────────────────────────
# Open News — Environment Configuration
# Copy to .env and fill in values.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://opennews:password@localhost:5432/opennews

# ─── Web Server ──────────────────────────────────────────────────────────────
PORT=3001
BASE_URL=https://open.news
SESSION_SECRET=change-me-at-least-16-characters

# ─── AT Protocol (Bluesky Bot) ───────────────────────────────────────────────
BSKY_BOT_DID=did:plc:your-bot-did
BSKY_BOT_PASSWORD=your-app-password
BSKY_OAUTH_CLIENT_ID=https://open.news/client-metadata.json
ATPROTO_PDS_URL=https://bsky.social

# ─── Jetstream (Firehose) ───────────────────────────────────────────────────
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# ─── LLM ─────────────────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic          # anthropic | openai | ollama
# OpenAI API key (for embedding / LLM fallbacks if used)
OPENAI_API_KEY="sk-..."

# --- Embedding Archiver (S3) ---
ENABLE_EMBEDDING_ARCHIVER="false"
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="track-embeddings"
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
LLM_API_KEY=sk-ant-...
LLM_MODEL=claude-3-5-haiku-20241022
# LLM_LIGHT_MODEL=              # optional lighter model for simple tasks
# LLM_OLLAMA_URL=http://localhost:11434

# ─── Search ──────────────────────────────────────────────────────────────────
# BRAVE_API_KEY=BSA...           # Brave Search API key (optional)

# ─── Track Infrastructure ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
OPENSEARCH_URL=http://localhost:9200

# ─── Track Web ───────────────────────────────────────────────────────────────
TRACK_PORT=4200
TRACK_BASE_URL=https://track.social
TRACK_OAUTH_CLIENT_ID=https://track.social/client-metadata.json

# ─── Feeds.social ────────────────────────────────────────────────────────────
FEEDS_PORT=4300
FEEDS_BASE_URL=https://feeds.social
FEEDS_OAUTH_CLIENT_ID=https://feeds.social/client-metadata.json
# ─── Track Bluesky Account (for custom feed) ────────────────────────────────
# TRACK_BSKY_HANDLE=track-social.bsky.social
# TRACK_BSKY_PASSWORD=your-app-password

# ─── Track Feed ──────────────────────────────────────────────────────────────
# TRACK_FEED_EXPLAINER_URI=at://did:plc:.../app.bsky.feed.post/...

# ─── Embedding Service ──────────────────────────────────────────────────────
EMBED_SERVICE_URL=http://localhost:8100

# ─── Admin ───────────────────────────────────────────────────────────────────
# ADMIN_HANDLES=your-handle.bsky.social

# ─── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=info                  # trace | debug | info | warn | error
NODE_ENV=production             # development | production | test

# OpenTelemetry (optional)
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=open-news
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic ...

# AppSignal (optional)
# APPSIGNAL_COLLECTOR_ENDPOINT=https://....appsignal-collector.net
# APPSIGNAL_APP_NAME=open-news
# APPSIGNAL_PUSH_API_KEY=...
