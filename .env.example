# Database
DATABASE_URL=postgresql://localhost:5432/opennews

# AT Protocol / Bluesky
BSKY_BOT_DID=did:plc:xxxx           # The @open.news bot account DID
BSKY_BOT_PASSWORD=app-password-here  # App password for bot account
BSKY_OAUTH_CLIENT_ID=https://open.news/oauth/client-metadata.json
ATPROTO_PDS_URL=https://bsky.social  # Override for testing

# Jetstream
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe

# LLM (configure one provider)
LLM_PROVIDER=anthropic               # anthropic | openai | ollama
LLM_API_KEY=sk-ant-xxx
LLM_MODEL=claude-3-5-haiku-20241022
LLM_OLLAMA_URL=http://localhost:11434  # Only used when LLM_PROVIDER=ollama

# Web
PORT=3000
SESSION_SECRET=long-random-string-here-change-me
BASE_URL=https://open.news

# Operational
LOG_LEVEL=info
NODE_ENV=development
